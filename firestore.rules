rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    match /waiterCalls/{callId} {
      allow read, create, update, delete: if true;
    }

    match /test/{docId} {
      allow read: if true;
    }
  }
}
